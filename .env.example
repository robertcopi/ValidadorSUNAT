# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ==============================================================================
PROJECT_NAME="Sistema de Validación de Comprobantes SUNAT"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================================================================
# BASE DE DATOS (POSTGRESQL)
# Para Docker Compose, POSTGRES_SERVER debe ser 'postgres'
# Para ejecución local fuera de Docker, usar 'localhost'
# ==============================================================================
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sunat_user
POSTGRES_PASSWORD=sunat_secure_password_dev
POSTGRES_DB=sunat_consultas_db

# ==============================================================================
# CREDENCIALES SEED DE DESARROLLO (NO USAR EN PRODUCCIÓN)
# ==============================================================================
SEED_ADMIN_EMAIL=admin@sistema.local
SEED_ADMIN_PASSWORD=AdminDev2026!
SEED_CONTADOR_PASSWORD=ContadorDev2026!

# ==============================================================================
# CONFIGURACIÓN SUNAT API (FASE 2)
# ==============================================================================
SUNAT_AUTH_BASE_URL=https://api-seguridad.sunat.gob.pe/v1/clientesextranet
SUNAT_API_BASE_URL=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes
SUNAT_AUTH_SCOPE=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes
SUNAT_TIMEOUT_SECONDS=30.0

# Credenciales SUNAT Multiempresa - DAIRA (RUC 20538976815)
# API Consulta Integrada utiliza OAuth2 client_credentials (CLIENT_ID y CLIENT_SECRET)
SUNAT_DAIRA_CLIENT_ID=
SUNAT_DAIRA_CLIENT_SECRET=
# Opcionales / No requeridos para Consulta Integrada:
# SUNAT_DAIRA_SOL_USER=
# SUNAT_DAIRA_SOL_PASSWORD=

# Credenciales SUNAT Multiempresa - GRUPO JJD MAR (RUC 20612689831)
# API Consulta Integrada utiliza OAuth2 client_credentials (CLIENT_ID y CLIENT_SECRET)
SUNAT_JJD_CLIENT_ID=
SUNAT_JJD_CLIENT_SECRET=
# Opcionales / No requeridos para Consulta Integrada:
# SUNAT_JJD_SOL_USER=
# SUNAT_JJD_SOL_PASSWORD=

# NUEVAS EMPRESAS (Configuración dinámica sin modificar código):
# Para cualquier empresa adicional registrada con RUC XXXXXXXXXXX:
# SUNAT_XXXXXXXXXXX_CLIENT_ID=
# SUNAT_XXXXXXXXXXX_CLIENT_SECRET=

# Parámetros de resiliencia y concurrencia
SUNAT_MAX_CONCURRENCY=5
SUNAT_REQUEST_TIMEOUT=30.0
SUNAT_RETRY_MAX_ATTEMPTS=1
SUNAT_RETRY_BASE_DELAY=1.0

# ==============================================================================
# ALMACENAMIENTO DE ARCHIVOS
# ==============================================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# ==============================================================================
# CORS (FRONTEND)
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
